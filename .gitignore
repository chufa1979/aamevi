# Assets publicados por Filament: los regenera `php artisan filament:assets`
# `css/app` es el nuestro, registrado en AppServiceProvider; la fuente vive en
# resources/css/filament/
/public/css/app
/public/css/filament
/public/js/filament
/public/fonts/filament

# Composer
# composer.lock SE COMMITEA: es lo que garantiza que el hosting instale
# exactamente las mismas versiones que se probaron acá.
