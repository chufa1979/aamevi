{
    "preset": "laravel",
    "rules": {
        "array_indentation": true,
        "blank_line_after_namespace": true,
        "class_attributes_separation": {
            "elements": {
                "method": "one"
            }
        },
        "not_operator_with_successor_space": true,
        "ordered_imports": {
            "sort_algorithm": "length"
        }
    }
}
